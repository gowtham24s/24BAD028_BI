    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Vaccination Coverage by Continent</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='compact' name='federated.0e4fm6d1kqnwys1g3p5ip0q01y3a' />
          </datasources>
          <datasource-dependencies datasource='federated.0e4fm6d1kqnwys1g3p5ip0q01y3a'>
            <column caption='People Vaccinated Clean' datatype='real' name='[Calculation_0248242862632963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([people_vaccinated],0)' />
            </column>
            <column caption='Vaccination Coverage' datatype='real' default-format='p0.00%' name='[Calculation_0248242865684489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([population]) = 0 THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    MAX([Calculation_0248242862632963]) / MAX([population])&#13;&#10;END' />
            </column>
