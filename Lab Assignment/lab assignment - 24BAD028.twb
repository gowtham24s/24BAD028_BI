      <aliases enabled='yes' />
      <column caption='Visit Volume' datatype='real' name='[Calculation_1129510998351873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Wait Time&quot; THEN&#13;&#10;    AVG([wait_time_min])&#13;&#10;ELSE&#13;&#10;    COUNT([visit_id])&#13;&#10;END' />
      </column>
      <column caption='Department Wait Rank' datatype='integer' name='[Calculation_1129510999949314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(AVG([wait_time_min]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='citycare_er_visits.csv' datatype='table' name='[__tableau_internal_object_id__].[citycare_er_visits.csv_29E601E95B5A4F47A47896B1CF14516D]' role='measure' type='quantitative' />
